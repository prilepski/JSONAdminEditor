{
  "customerName": "MICROSOFT",
  "customSettings": {
    "theme": "microsoft-blue",
    "logoUrl": "/images/microsoft-logo.png",
    "primaryColor": "#0078D4",
    "secondaryColor": "#005A9E"
  },
  "features": {
    "enableAdvancedReporting": true,
    "customDashboard": true,
    "maxUsers": 1000
  },
  "integrations": {
    "sso": {
      "enabled": true,
      "provider": "Azure AD"
    },
    "api": {
      "rateLimit": 2000,
      "customEndpoints": ["teams", "outlook", "sharepoint"]
    }
  }
}
