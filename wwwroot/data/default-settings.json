{
  "applicationName": "JSON Admin Editor",
  "version": "1.0.0",
  "environment": "production",
  "database": {
    "connectionTimeout": 30,
    "maxPoolSize": 100
  },
  "logging": {
    "level": "Info",
    "enableFileLogging": true
  },
  "features": {
    "enableAdvancedEditing": true,
    "enableFileValidation": true,
    "maxFileSize": "10MB"
  }
}
