{
  "name": "json-admin-editor-react",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@ebay/nice-modal-react": "^1.2.13",
    "@okta/okta-auth-js": "^7.14.0",
    "@okta/okta-react": "^6.10.0",
    "@tanstack/react-query": "^5.59.16",
    "axios": "^1.7.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-error-boundary": "^6.0.0",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.27.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@tanstack/react-query-devtools": "^5.89.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.0.0",
    "@types/node": "^24.5.2",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "@vitejs/plugin-react": "^4.0.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "jsdom": "^22.1.0",
    "lint-staged": "^16.1.6",
    "openapi-typescript": "^7.9.1",
    "prettier": "^3.6.2",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.6",
    "vitest": "^0.32.4"
  },
  "scripts": {
    "dev": "vite --mode dev",
    "build": "tsc --noEmit && vite build",
    "build:dev": "vite build --mode development",
    "build:prod": "tsc --noEmit && vite build --mode production",
    "preview": "vite preview",
    "test": "vitest --mode dev",
    "test:ui": "vitest --ui --mode dev",
    "test:coverage": "vitest --coverage --mode dev",
    "lint": "eslint src --ext .ts,.tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write 'src/**/*.{ts,tsx,css,md}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,css,md}'",
    "generate-types": "node scripts/generate-types.js",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,md}": [
      "prettier --write"
    ]
  },
  "type": "module"
}
