VITE_API_BASE_URL=/api
VITE_APP_NAME=JSON Admin Editor (Local)
VITE_APP_ENV=local
VITE_ENABLE_DEVTOOLS=true
VITE_DEV_PORT=3000
VITE_PROXY_TARGET=http://localhost:8080
