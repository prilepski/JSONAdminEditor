VITE_API_BASE_URL=/api
VITE_APP_ENV=development
VITE_APP_NAME=JSON Admin Editor (Dev)
VITE_ENABLE_DEVTOOLS=true
VITE_LOG_LEVEL=debug
VITE_DEV_PORT=3000
VITE_PROXY_TARGET=http://localhost:8080
VITE_BUILD_DIR=build
VITE_SOURCEMAP=true

