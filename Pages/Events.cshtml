@page
@model JSONAdminEditor.Pages.EventsModel
@{
    ViewData["Title"] = "Events";
}

<div class="container-fluid">
    <h1 class="mb-4">Events Management</h1>
            
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@Model.ErrorMessage
        </div>
    }
    
    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success" role="alert">
            <i class="fas fa-check-circle me-2"></i>@Model.SuccessMessage
        </div>
    }

    <!-- Event Selection -->
    <div class="card mb-4">
        <div class="card-header">
            <h3><i class="fas fa-calendar-alt me-2"></i>Select Event</h3>
            <p class="mb-0 text-muted">Configure event-specific notification settings including order types, template IDs, and communication preferences. Select an event from the dropdown to edit its configuration.</p>
        </div>
        <div class="card-body">
            <form method="get" id="eventSelectionForm">
                <div class="mb-3">
                    <select class="form-select" name="selectedEvent" id="selectedEvent" onchange="this.form.submit()">
                        <option value="">Select an event...</option>
                        @if (Model.ActiveEventTriggers?.Any() == true)
                        {
                            foreach (var trigger in Model.ActiveEventTriggers)
                            {
                                <option value="@trigger" selected="@(trigger == Model.SelectedEvent ? "selected" : null)">@trigger</option>
                            }
                        }
                    </select>
                </div>
            </form>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.SelectedEvent) && Model.EventData != null)
    {
        <!-- Event Data Editor -->
        <div class="card">
            <div class="card-header">
                <h3>
                    <i class="fas @(Model.IsNewEvent ? "fa-plus" : "fa-edit") me-2"></i>
                    @(Model.IsNewEvent ? "Add New Event" : "Edit Event"): @Model.SelectedEvent
                </h3>
                @if (Model.IsNewEvent)
                {
                    <small class="text-muted">Creating new event from template</small>
                }
            </div>
            <div class="card-body">
                <!-- Tab Navigation -->
                <ul class="nav nav-tabs mb-3" id="eventTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="event-data-tab" data-bs-toggle="tab" data-bs-target="#event-data" type="button" role="tab" aria-controls="event-data" aria-selected="true">
                            <i class="fas fa-cog me-1"></i>Event Data
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="templates-tab" data-bs-toggle="tab" data-bs-target="#templates" type="button" role="tab" aria-controls="templates" aria-selected="false">
                            <i class="fas fa-file-alt me-1"></i>Templates
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="content-variables-tab" data-bs-toggle="tab" data-bs-target="#content-variables" type="button" role="tab" aria-controls="content-variables" aria-selected="false">
                            <i class="fas fa-code me-1"></i>Content Variables
                        </button>
                    </li>
                </ul>

                <!-- Tab Content -->
                <div class="tab-content" id="eventTabsContent">
                    <!-- Event Data Tab -->
                    <div class="tab-pane fade show active" id="event-data" role="tabpanel" aria-labelledby="event-data-tab">
                        <form method="post" asp-page-handler="SaveEventData" id="eventDataForm">
                            <input type="hidden" asp-for="SelectedEvent" />
                            <input type="hidden" asp-for="IsNewEvent" />
                            
                            @if (Model.ValidationErrors?.Any() == true)
                            {
                                <div class="alert alert-danger">
                                    <h6>Please fix the following errors:</h6>
                                    <ul class="mb-0">
                                        @foreach (var error in Model.ValidationErrors)
                                        {
                                            <li>@error.Message</li>
                                        }
                                    </ul>
                                </div>
                            }

                            <div class="table-responsive">
                                <table class="table table-bordered table-striped">
                                    <thead class="table-dark">
                                        <tr>
                                            <th style="width: 30%">Property</th>
                                            <th>Value</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <!-- Event Name (Read-only) -->
                                        <tr>
                                            <td><strong>Event</strong></td>
                                            <td>
                                                <input type="text" class="form-control" value="@Model.SelectedEvent" readonly />
                                                <small class="text-muted">This field is read-only and matches the selected event.</small>
                                            </td>
                                        </tr>
                                        
                                        <!-- OrderType -->
                                        <tr>
                                            <td><strong>OrderType</strong></td>
                                            <td>
                                                @{
                                                    var orderTypeValue = Model.EventData.TryGetValue("OrderType", out var ot) ? ot?.ToString() : "";
                                                    var hasOrderTypeError = Model.ValidationErrors?.Any(e => e.FieldName == "OrderType") == true;
                                                    var orderTypeError = hasOrderTypeError ? Model.ValidationErrors?.FirstOrDefault(e => e.FieldName == "OrderType")?.Message : "";
                                                }
                                                <select name="OrderType" class="form-select @(hasOrderTypeError ? "is-invalid" : "")">
                                                    <option value="">Select Order Type...</option>
                                                    @if (Model.AvailableOrderTypes?.Any() == true)
                                                    {
                                                        foreach (var orderType in Model.AvailableOrderTypes)
                                                        {
                                                            <option value="@orderType" selected="@(orderType.Equals(orderTypeValue, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@orderType</option>
                                                        }
                                                    }
                                                </select>
                                                @if (hasOrderTypeError)
                                                {
                                                    <div class="invalid-feedback">@orderTypeError</div>
                                                }
                                            </td>
                                        </tr>
                                        
                                        <!-- Phone -->
                                        <tr>
                                            <td><strong>Phone</strong></td>
                                            <td>
                                                @{
                                                    var phoneValue = Model.EventData.TryGetValue("Phone", out var phone) ? phone?.ToString() : "";
                                                }
                                                <input type="text" name="Phone" class="form-control" value="@phoneValue" placeholder="Enter phone variable (e.g., $consigneeContact.phone$)" />
                                                <small class="text-muted">Variable for phone number</small>
                                            </td>
                                        </tr>
                                        
                                        <!-- Email -->
                                        <tr>
                                            <td><strong>Email</strong></td>
                                            <td>
                                                @{
                                                    var emailValue = Model.EventData.TryGetValue("Email", out var email) ? email?.ToString() : "";
                                                }
                                                <input type="text" name="Email" class="form-control" value="@emailValue" placeholder="Enter email variable (e.g., $consigneeContact.email$)" />
                                                <small class="text-muted">Variable for email address</small>
                                            </td>
                                        </tr>
                                        
                                        <!-- Logo -->
                                        <tr>
                                            <td><strong>Logo</strong></td>
                                            <td>
                                                @{
                                                    var logoValue = Model.EventData.TryGetValue("Logo", out var logo) ? logo?.ToString() : "";
                                                }
                                                <input type="text" name="Logo" class="form-control" value="@logoValue" placeholder="Enter logo data (e.g., base64:...)" />
                                                <small class="text-muted">Logo data in base64 format</small>
                                            </td>
                                        </tr>
                                        
                                        <!-- IsSuppressed -->
                                        <tr>
                                            <td><strong>IsSuppressed</strong></td>
                                            <td>
                                                @{
                                                    var isSuppressedValue = Model.EventData.TryGetValue("IsSuppressed", out var isSup) ? isSup?.ToString()?.ToLower() : "false";
                                                }
                                                <select name="IsSuppressed" class="form-select">
                                                    <option value="true" selected="@(isSuppressedValue == "true" ? "selected" : null)">True</option>
                                                    <option value="false" selected="@(isSuppressedValue == "false" ? "selected" : null)">False</option>
                                                </select>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            
                            <div class="d-flex justify-content-end mt-3">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas @(Model.IsNewEvent ? "fa-plus" : "fa-save") me-1"></i>
                                    @(Model.IsNewEvent ? "Add Event" : "Save Event Data")
                                </button>
                            </div>
                        </form>
                    </div>

                    <!-- Templates Tab -->
                    <div class="tab-pane fade" id="templates" role="tabpanel" aria-labelledby="templates-tab">
                        <form method="post" asp-page-handler="SaveTemplates" id="templatesForm">
                            <input type="hidden" asp-for="SelectedEvent" />
                            
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h4>Templates Configuration</h4>
                                <small class="text-muted">Configure email, SMS, and voice templates for this event</small>
                            </div>
                            
                            <div class="table-responsive">
                                <table class="table table-bordered table-striped">
                                    <thead class="table-dark">
                                        <tr>
                                            <th style="width: 30%">Template Type</th>
                                            <th>Template ID</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <!-- Email Template -->
                                        <tr>
                                            <td><strong>Email</strong></td>
                                            <td>
                                                @{
                                                    var emailTemplateValue = "";
                                                    if (Model.EventData.TryGetValue("Templates", out var templates) && templates is Dictionary<string, object> templatesDict)
                                                    {
                                                        emailTemplateValue = templatesDict.TryGetValue("Email", out var et) ? et?.ToString() : "";
                                                    }
                                                }
                                                <select name="Templates.Email" class="form-select">
                                                    <option value="">Select Email Template...</option>
                                                    @if (Model.AvailableTemplates?.Any() == true)
                                                    {
                                                        foreach (var template in Model.AvailableTemplates)
                                                        {
                                                            <option value="@template.TemplateId" selected="@(template.TemplateId.Equals(emailTemplateValue, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">
                                                                @template.TemplateName (@template.TemplateId)
                                                            </option>
                                                        }
                                                    }
                                                </select>
                                            </td>
                                        </tr>
                                        
                                        <!-- SMS Template -->
                                        <tr>
                                            <td><strong>SMS</strong></td>
                                            <td>
                                                @{
                                                    var smsTemplateValue = "";
                                                    if (Model.EventData.TryGetValue("Templates", out var smsTemplates) && smsTemplates is Dictionary<string, object> smsTemplatesDict)
                                                    {
                                                        smsTemplateValue = smsTemplatesDict.TryGetValue("Sms", out var st) ? st?.ToString() : "";
                                                    }
                                                }
                                                <select name="Templates.Sms" class="form-select">
                                                    <option value="">Select SMS Template...</option>
                                                    @if (Model.AvailableTemplates?.Any() == true)
                                                    {
                                                        foreach (var template in Model.AvailableTemplates)
                                                        {
                                                            <option value="@template.TemplateId" selected="@(template.TemplateId.Equals(smsTemplateValue, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">
                                                                @template.TemplateName (@template.TemplateId)
                                                            </option>
                                                        }
                                                    }
                                                </select>
                                            </td>
                                        </tr>
                                        
                                        <!-- Voice Template -->
                                        <tr>
                                            <td><strong>Voice</strong></td>
                                            <td>
                                                @{
                                                    var voiceTemplateValue = "";
                                                    if (Model.EventData.TryGetValue("Templates", out var voiceTemplates) && voiceTemplates is Dictionary<string, object> voiceTemplatesDict)
                                                    {
                                                        voiceTemplateValue = voiceTemplatesDict.TryGetValue("Voice", out var vt) ? vt?.ToString() : "";
                                                    }
                                                }
                                                <select name="Templates.Voice" class="form-select">
                                                    <option value="">Select Voice Template...</option>
                                                    @if (Model.AvailableTemplates?.Any() == true)
                                                    {
                                                        foreach (var template in Model.AvailableTemplates)
                                                        {
                                                            <option value="@template.TemplateId" selected="@(template.TemplateId.Equals(voiceTemplateValue, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">
                                                                @template.TemplateName (@template.TemplateId)
                                                            </option>
                                                        }
                                                    }
                                                </select>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            
                            <div class="d-flex justify-content-end mt-3">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-save me-1"></i>Save Templates
                                </button>
                            </div>
                        </form>
                    </div>

                    <!-- Content Variables Tab -->
                    <div class="tab-pane fade" id="content-variables" role="tabpanel" aria-labelledby="content-variables-tab">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h4>Content Variables Editor</h4>
                            <div>
                                <button type="button" class="btn btn-success me-2" id="addVariableBtn">
                                    <i class="fas fa-plus me-1"></i>Add Variable
                                </button>
                                <button type="button" class="btn btn-primary" id="saveVariablesBtn">
                                    <i class="fas fa-save me-1"></i>Save Variables
                                </button>
                            </div>
                        </div>
                        
                        <div id="contentVariablesContainer">
                            <div class="text-center py-4" id="variablesLoadingState">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                                <p class="mt-2 text-muted">Loading content variables...</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (!string.IsNullOrEmpty(Model.SelectedEvent))
    {
        <div class="card">
            <div class="card-body text-center py-4">
                <i class="fas fa-exclamation-triangle fa-3x text-warning mb-3"></i>
                <h4 class="text-muted">Event Not Found</h4>
                <p class="text-muted">The selected event "@Model.SelectedEvent" was not found in the notifications.json file.</p>
                <p class="text-muted">
                    <a href="#" onclick="addEventToNotifications('@Model.SelectedEvent')" class="btn btn-outline-primary">
                        <i class="fas fa-plus me-1"></i>Add @Model.SelectedEvent to notifications.json
                    </a>
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body text-center py-4">
                <i class="fas fa-calendar-alt fa-3x text-muted mb-3"></i>
                <h4 class="text-muted">Select an Event</h4>
                <p class="text-muted">Choose an event from the dropdown above to start editing its configuration.</p>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        let eventContentVariables = {};
        let globalContentVariables = {};
        let currentEventName = '@(Model.SelectedEvent ?? "")';
        
        // Clear validation errors when user types
        document.addEventListener('DOMContentLoaded', function() {
            const inputs = document.querySelectorAll('#eventDataForm input, #eventDataForm select');
            inputs.forEach(input => {
                input.addEventListener('input', function() {
                    this.classList.remove('is-invalid');
                    const feedback = this.parentNode.querySelector('.invalid-feedback');
                    if (feedback) {
                        feedback.style.display = 'none';
                    }
                });
            });
            
            // Initialize content variables tab functionality
            const contentVariablesTab = document.getElementById('content-variables-tab');
            const addVariableBtn = document.getElementById('addVariableBtn');
            const saveVariablesBtn = document.getElementById('saveVariablesBtn');
            
            if (contentVariablesTab) {
                contentVariablesTab.addEventListener('shown.bs.tab', function() {
                    if (currentEventName) {
                        loadContentVariables();
                    }
                });
            }
            
            if (addVariableBtn) {
                addVariableBtn.addEventListener('click', addNewVariable);
            }
            
            if (saveVariablesBtn) {
                saveVariablesBtn.addEventListener('click', saveContentVariables);
            }
            
            // Load content variables immediately if an event is already selected
            if (currentEventName) {
                loadContentVariables();
            }
        });

        // Function to add new event to notifications.json
        function addEventToNotifications(eventName) {
            // Redirect to the same page with parameters to add new event
            window.location.href = '/Events?handler=AddEvent&eventName=' + encodeURIComponent(eventName);
        }
        
        async function loadContentVariables() {
            try {
                const container = document.getElementById('contentVariablesContainer');
                const loadingState = document.getElementById('variablesLoadingState');
                
                if (loadingState) {
                    loadingState.style.display = 'block';
                }
                
                const response = await fetch(`/Events?handler=ContentVariables&eventName=${encodeURIComponent(currentEventName)}`, {
                    method: 'GET',
                    headers: {
                        'Accept': 'application/json'
                    }
                });
                
                if (response.ok) {
                    const result = await response.json();
                    
                    if (result.success) {
                        eventContentVariables = result.data.eventVariables || {};
                        globalContentVariables = result.data.globalVariables || {};
                        renderContentVariablesEditor();
                    } else {
                        throw new Error(result.error || 'Failed to load content variables');
                    }
                } else {
                    throw new Error(`HTTP ${response.status}: ${response.statusText}`);
                }
            } catch (error) {
                console.error('Error loading content variables:', error);
                showEmptyVariablesEditor();
            } finally {
                const loadingState = document.getElementById('variablesLoadingState');
                if (loadingState) {
                    loadingState.style.display = 'none';
                }
            }
        }
        
        function renderContentVariablesEditor() {
            const container = document.getElementById('contentVariablesContainer');
            
            // Create combined list with proper ordering: custom event variables first, then global variables
            let tableHtml = `
                <div class="table-responsive">
                    <table class="table table-striped table-hover" id="contentVariablesTable">
                        <thead class="table-dark">
                            <tr>
                                <th style="width: 25%">Variable Name</th>
                                <th style="width: 50%">Value</th>
                                <th style="width: 15%">Is Redefined</th>
                                <th style="width: 10%">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
            `;
            
            // First, add custom event-specific variables that are NOT in global variables (purely event-specific)
            Object.entries(eventContentVariables).forEach(([key, value]) => {
                // Skip if this variable is a redefined global variable (will be handled below)
                if (globalContentVariables.hasOwnProperty(key)) {
                    return;
                }
                
                // This is a purely event-specific custom variable - show at top
                tableHtml += `
                    <tr data-variable-type="event" data-original-key="${key}">
                        <td>
                            <input type="text" class="form-control form-control-sm variable-name" value="${escapeHtml(key)}" />
                        </td>
                        <td>
                            <input type="text" class="form-control form-control-sm variable-value" value="${escapeHtml(value)}" />
                        </td>
                        <td class="text-center">
                            <span class="text-muted">-</span>
                        </td>
                        <td class="text-center">
                            <button type="button" class="btn btn-danger btn-sm delete-variable" onclick="deleteVariable(this)">
                                <i class="fas fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                `;
            });
            
            // Then, display all global variables and check if they are redefined in event variables
            Object.entries(globalContentVariables).forEach(([key, globalValue]) => {
                const isRedefined = eventContentVariables.hasOwnProperty(key);
                const actualValue = isRedefined ? eventContentVariables[key] : globalValue;
                
                tableHtml += `
                    <tr data-variable-type="global" data-original-key="${key}">
                        <td>
                            <input type="text" class="form-control form-control-sm variable-name" value="${escapeHtml(key)}" readonly />
                        </td>
                        <td>
                            <input type="text" class="form-control form-control-sm variable-value" value="${escapeHtml(actualValue)}" ${!isRedefined ? 'readonly' : ''} />
                        </td>
                        <td class="text-center">
                            <div class="form-check">
                                <input class="form-check-input redefined-checkbox" type="checkbox" ${isRedefined ? 'checked' : ''} onchange="toggleVariableRedefinition(this)" />
                            </div>
                        </td>
                        <td class="text-center">
                            <span class="text-muted">-</span>
                        </td>
                    </tr>
                `;
            });
            
            tableHtml += `
                        </tbody>
                    </table>
                </div>
            `;
            
            container.innerHTML = tableHtml;
            
            // If no variables exist, show empty state
            if (Object.keys(eventContentVariables).length === 0 && Object.keys(globalContentVariables).length === 0) {
                showEmptyVariablesEditor();
            }
        }
        
        function showEmptyVariablesEditor() {
            const container = document.getElementById('contentVariablesContainer');
            container.innerHTML = `
                <div class="text-center py-4">
                    <i class="fas fa-code fa-3x text-muted mb-3"></i>
                    <h5 class="text-muted">No Content Variables</h5>
                    <p class="text-muted">No content variables found for this event. Click "Add Variable" to start adding variables.</p>
                </div>
            `;
        }
        
        function addNewVariable() {
            const table = document.getElementById('contentVariablesTable');
            let tbody;
            
            if (!table) {
                // Create new table if it doesn't exist
                const container = document.getElementById('contentVariablesContainer');
                container.innerHTML = `
                    <div class="table-responsive">
                        <table class="table table-striped table-hover" id="contentVariablesTable">
                            <thead class="table-dark">
                                <tr>
                                    <th style="width: 25%">Variable Name</th>
                                    <th style="width: 50%">Value</th>
                                    <th style="width: 15%">Is Redefined</th>
                                    <th style="width: 10%">Actions</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                `;
                tbody = document.querySelector('#contentVariablesTable tbody');
            } else {
                tbody = table.getElementsByTagName('tbody')[0];
            }
            
            // Insert new row at the top
            const newRow = tbody.insertRow(0);
            newRow.setAttribute('data-variable-type', 'event');
            newRow.setAttribute('data-original-key', '');
            
            newRow.innerHTML = `
                <td>
                    <input type="text" class="form-control form-control-sm variable-name" value="" placeholder="Enter variable name" />
                </td>
                <td>
                    <input type="text" class="form-control form-control-sm variable-value" value="" placeholder="Enter variable value" />
                </td>
                <td class="text-center">
                    <span class="text-muted">-</span>
                </td>
                <td class="text-center">
                    <button type="button" class="btn btn-danger btn-sm delete-variable" onclick="deleteVariable(this)">
                        <i class="fas fa-trash"></i>
                    </button>
                </td>
            `;
            
            // Focus on the new variable name input
            const nameInput = newRow.querySelector('.variable-name');
            if (nameInput) {
                nameInput.focus();
            }
        }
        
        function deleteVariable(button) {
            if (confirm('Are you sure you want to delete this variable?')) {
                const row = button.closest('tr');
                row.remove();
                
                // Check if table is now empty
                const table = document.getElementById('contentVariablesTable');
                if (table && table.getElementsByTagName('tbody')[0].rows.length === 0) {
                    showEmptyVariablesEditor();
                }
            }
        }
        
        function toggleVariableRedefinition(checkbox) {
            const row = checkbox.closest('tr');
            const valueInput = row.querySelector('.variable-value');
            const originalKey = row.getAttribute('data-original-key');
            
            if (checkbox.checked) {
                // Enable editing - use value from event variables if it exists, otherwise use global value
                valueInput.readOnly = false;
                valueInput.classList.remove('text-muted');
                if (eventContentVariables[originalKey] !== undefined) {
                    valueInput.value = eventContentVariables[originalKey];
                }
            } else {
                // Disable editing - revert to global value
                valueInput.readOnly = true;
                valueInput.classList.add('text-muted');
                valueInput.value = globalContentVariables[originalKey] || '';
            }
        }
        
        async function saveContentVariables() {
            try {
                const saveBtn = document.getElementById('saveVariablesBtn');
                const originalText = saveBtn.innerHTML;
                saveBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status"></span>Saving...';
                saveBtn.disabled = true;
                
                // Collect all variables to save
                const variablesToSave = {};
                const table = document.getElementById('contentVariablesTable');
                
                if (table) {
                    const rows = table.getElementsByTagName('tbody')[0].rows;
                    
                    for (let i = 0; i < rows.length; i++) {
                        const row = rows[i];
                        const variableType = row.getAttribute('data-variable-type');
                        const nameInput = row.querySelector('.variable-name');
                        const valueInput = row.querySelector('.variable-value');
                        const checkbox = row.querySelector('.redefined-checkbox');
                        
                        const name = nameInput.value.trim();
                        const value = valueInput.value.trim();
                        
                        if (name) {
                            if (variableType === 'event') {
                                // Always include event-specific variables
                                variablesToSave[name] = value;
                            } else if (variableType === 'global' && checkbox && checkbox.checked) {
                                // Include global variables only if they are redefined (checkbox checked)
                                variablesToSave[name] = value;
                            }
                        }
                    }
                }
                
                // Save to server
                const formData = new FormData();
                formData.append('eventName', currentEventName);
                formData.append('contentVariables', JSON.stringify(variablesToSave));
                
                const response = await fetch('/Events?handler=SaveContentVariables', {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                    }
                });
                
                const result = await response.json();
                
                if (result.success) {
                    // Update local state
                    eventContentVariables = variablesToSave;
                    
                    // Show success message
                    showMessage(result.message, 'success');
                    
                    // Re-render the editor to reflect saved state
                    renderContentVariablesEditor();
                } else {
                    showMessage(result.error || 'Failed to save content variables.', 'error');
                }
                
            } catch (error) {
                console.error('Error saving content variables:', error);
                showMessage('An error occurred while saving. Please try again.', 'error');
            } finally {
                const saveBtn = document.getElementById('saveVariablesBtn');
                saveBtn.innerHTML = '<i class="fas fa-save me-1"></i>Save Variables';
                saveBtn.disabled = false;
            }
        }
        
        function showMessage(message, type) {
            // Remove any existing alerts
            const existingAlerts = document.querySelectorAll('.alert.alert-success, .alert.alert-danger');
            existingAlerts.forEach(alert => alert.remove());
            
            // Create new alert
            const alertClass = type === 'success' ? 'alert-success' : 'alert-danger';
            const iconClass = type === 'success' ? 'fa-check-circle' : 'fa-exclamation-triangle';
            
            const alertDiv = document.createElement('div');
            alertDiv.className = `alert ${alertClass} alert-dismissible fade show`;
            alertDiv.innerHTML = `
                <i class="fas ${iconClass} me-2"></i>${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            `;
            
            // Insert after the event selection card
            const eventSelectionCard = document.querySelector('.card');
            eventSelectionCard.insertAdjacentElement('afterend', alertDiv);
            
            // Auto-remove after 5 seconds
            setTimeout(() => {
                if (alertDiv.parentNode) {
                    alertDiv.remove();
                }
            }, 5000);
        }
        
        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }
    </script>
}
