@page
@model JSONAdminEditor.Pages.CustomerSettingsModel
@using JSONAdminEditor.Models
@using System
@{
    ViewData["Title"] = "Manage Customer Overrides";
}

<div class="container-fluid">
    <h1 class="mb-4">Manage Customer Overrides</h1>
            
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger" role="alert">
                    @Model.ErrorMessage
                </div>
            }
            
            @if (!string.IsNullOrEmpty(Model.SuccessMessage))
            {
                <div class="alert alert-success" role="alert">
                    @Model.SuccessMessage
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.ConfirmationMessage))
            {
                <div class="alert alert-warning" role="alert">
                    <h5>Confirmation Required</h5>
                    <p>@Model.ConfirmationMessage</p>
                    <form method="post" asp-page-handler="ConfirmOverwrite" class="d-inline">
                        <input type="hidden" asp-for="PendingUpload.CustomerName" />
                        <input type="hidden" asp-for="PendingUpload.CustomerIdForFilename" />
                        <button type="submit" class="btn btn-warning me-2">Yes, Overwrite</button>
                    </form>
                    <a href="/CustomerSettings" class="btn btn-secondary">Cancel</a>
                </div>
            }

            <!-- File Upload Section -->
            <div class="card mb-4">
                <div class="card-header">
                    <h3><i class="fas fa-upload me-2"></i>Upload Customer Override File</h3>
                </div>
                <div class="card-body">
                    <form method="post" enctype="multipart/form-data" asp-page-handler="Upload">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Upload.CustomerName" class="form-label">Customer Name:</label>
                                    <div class="position-relative">
                                        <input asp-for="Upload.CustomerName" class="form-control" placeholder="Start typing customer name or ID..." 
                                               autocomplete="off" id="customerNameInput" required />
                                        <div id="customerSuggestions" class="position-absolute w-100 bg-white border rounded shadow-sm" 
                                             style="display: none; z-index: 1000; max-height: 200px; overflow-y: auto; top: 100%;">
                                        </div>
                                    </div>
                                    <div class="form-text">Select a customer from suggestions. Filename will be based on Customer ID (e.g., CUST001.json)</div>
                                    <span asp-validation-for="Upload.CustomerName" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Upload.JsonFile" class="form-label">Select JSON File:</label>
                                    <input asp-for="Upload.JsonFile" class="form-control" accept=".json" required>
                                    <span asp-validation-for="Upload.JsonFile" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-upload me-1"></i>Upload Customer Override
                        </button>
                    </form>
                </div>
            </div>



            <!-- Customer Override Editing Section -->
            <div id="editingSection" class="card" style="display: none;">
                <div class="card-header">
                    <h3 id="editingHeader">
                        <i class="fas fa-edit me-2"></i>
                        Edit Customer Overrides: <span id="editingCustomerName"></span>
                    </h3>
                    <small class="text-muted">Configure customer-specific overrides for events and content variables</small>
                </div>
                <div class="card-body" id="editingContent">
                    <!-- Tab Navigation -->
                    <ul class="nav nav-tabs mb-3" id="customerTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="content-variables-tab" data-bs-toggle="tab" data-bs-target="#content-variables" type="button" role="tab" aria-controls="content-variables" aria-selected="true">
                                <i class="fas fa-code me-1"></i>Content Variables
                            </button>
                        </li>
                    </ul>

                    <!-- Tab Content -->
                    <div class="tab-content" id="customerTabsContent">
                        <!-- Content Variables Tab -->
                        <div class="tab-pane fade show active" id="content-variables" role="tabpanel" aria-labelledby="content-variables-tab">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h4>Content Variables Editor</h4>
                                <div>
                                    <button type="button" class="btn btn-success me-2" id="addVariableBtn">
                                        <i class="fas fa-plus me-1"></i>Add Variable
                                    </button>
                                    <button type="button" class="btn btn-primary" id="saveVariablesBtn">
                                        <i class="fas fa-save me-1"></i>Save Variables
                                    </button>
                                </div>
                            </div>
                            
                            <div id="contentVariablesContainer">
                                <div class="text-center py-4" id="variablesLoadingState">
                                    <div class="spinner-border text-primary" role="status">
                                        <span class="visually-hidden">Loading...</span>
                                    </div>
                                    <p class="mt-2 text-muted">Loading content variables...</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Default State Section -->
            <div id="defaultSection" class="card">
                <div class="card-body text-center py-4">
                    <i class="fas fa-user-cog fa-3x text-muted mb-3"></i>
                    <h4 class="text-muted">Select a Customer</h4>
                    <p class="text-muted">Choose a customer from the search box above to start editing their override configuration.</p>
                </div>
            </div>
        </div>
    </div>

@section Scripts {
    <script>
        let searchTimeout;
        let selectedCustomerValid = false;
        let selectedCustomerData = null;

        function setupCustomerSearch() {
            const customerInput = document.getElementById('customerNameInput');
            if (!customerInput) return;

            // Remove existing event listeners to avoid duplicates
            customerInput.removeEventListener('input', handleInput);
            customerInput.removeEventListener('focus', handleFocus);
            customerInput.removeEventListener('blur', handleBlur);

            // Add event listeners
            customerInput.addEventListener('input', handleInput);
            customerInput.addEventListener('focus', handleFocus);
            customerInput.addEventListener('blur', handleBlur);
        }

        function handleInput(e) {
            const searchTerm = e.target.value.trim();
            selectedCustomerValid = false;
            selectedCustomerData = null;
            
            // Hide editing section when input changes
            hideEditingSection();
            
            // Remove the data-customer-id attribute when user types manually
            e.target.removeAttribute('data-customer-id');
            
            if (searchTimeout) {
                clearTimeout(searchTimeout);
            }

            if (searchTerm.length < 2) {
                hideSuggestions();
                return;
            }

            searchTimeout = setTimeout(() => {
                searchCustomers(searchTerm);
            }, 300);
        }

        function handleFocus(e) {
            const searchTerm = e.target.value.trim();
            if (searchTerm.length >= 2) {
                searchCustomers(searchTerm);
            }
        }

        function handleBlur(e) {
            // Delay hiding to allow click on suggestions
            setTimeout(() => {
                hideSuggestions();
            }, 150);
        }

        function searchCustomers(searchTerm) {
            fetch(`/CustomerSettings?handler=SearchCustomers&term=${encodeURIComponent(searchTerm)}`)
                .then(response => response.json())
                .then(customers => {
                    displaySuggestions(customers, searchTerm);
                })
                .catch(error => {
                    console.error('Error searching customers:', error);
                    hideSuggestions();
                });
        }

        function displaySuggestions(customers, searchTerm) {
            const suggestionsDiv = document.getElementById('customerSuggestions');
            if (!suggestionsDiv) return;

            suggestionsDiv.innerHTML = '';

            if (!customers || customers.length === 0) {
                // Show "No matches found" message
                const noMatchDiv = document.createElement('div');
                noMatchDiv.className = 'p-2 text-muted';
                noMatchDiv.style.fontStyle = 'italic';
                noMatchDiv.innerHTML = '<i class="fas fa-search me-2"></i>No matches found';
                suggestionsDiv.appendChild(noMatchDiv);
                suggestionsDiv.style.display = 'block';
                return;
            }
            
            customers.forEach(customer => {
                const div = document.createElement('div');
                div.className = 'p-2 border-bottom customer-suggestion';
                div.style.cursor = 'pointer';
                div.style.borderBottom = '1px solid #dee2e6';
                
                // Create display text in format "Company Name (Customer ID)"
                const displayText = `${customer.companyName} (${customer.customerId})`;
                const highlightedText = highlightMatch(displayText, searchTerm);
                div.innerHTML = highlightedText;
                
                // Add hover effects
                div.addEventListener('mouseenter', function() {
                    this.style.backgroundColor = '#f8f9fa';
                });
                
                div.addEventListener('mouseleave', function() {
                    this.style.backgroundColor = 'white';
                });
                
                div.addEventListener('click', function() {
                    selectCustomer(customer);
                });
                
                suggestionsDiv.appendChild(div);
            });

            suggestionsDiv.style.display = 'block';
        }

        function highlightMatch(text, searchTerm) {
            const regex = new RegExp(`(${escapeRegex(searchTerm)})`, 'gi');
            return text.replace(regex, '<mark>$1</mark>');
        }

        function escapeRegex(string) {
            return string.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        }

        function selectCustomer(customer) {
            const customerInput = document.getElementById('customerNameInput');
            if (customerInput) {
                // Display as "Company Name (Customer ID)" in the text box
                customerInput.value = `${customer.companyName} (${customer.customerId})`;
                customerInput.setAttribute('data-customer-id', customer.customerId);
                selectedCustomerValid = true;
                selectedCustomerData = customer;
                
                // Load customer override data automatically
                loadCustomerOverrideData(`${customer.companyName} (${customer.customerId})`);
            }
            hideSuggestions();
        }

        function hideSuggestions() {
            const suggestionsDiv = document.getElementById('customerSuggestions');
            if (suggestionsDiv) {
                suggestionsDiv.style.display = 'none';
            }
        }

        function loadCustomerOverrideData(customerDisplayName) {
            fetch(`/CustomerSettings?handler=CustomerOverrideData&customerDisplayName=${encodeURIComponent(customerDisplayName)}`)
                .then(response => response.json())
                .then(data => {
                    showEditingSection(data);
                })
                .catch(error => {
                    console.error('Error loading customer override data:', error);
                    hideEditingSection();
                });
        }

        function showEditingSection(data) {
            const defaultSection = document.getElementById('defaultSection');
            const editingSection = document.getElementById('editingSection');
            const editingCustomerName = document.getElementById('editingCustomerName');

            if (defaultSection) defaultSection.style.display = 'none';
            if (editingSection) editingSection.style.display = 'block';
            
            if (editingCustomerName) {
                editingCustomerName.textContent = data.customerDisplayName || '';
            }

            // Load content variables for this customer
            if (data.exists || !data.exists) { // Show editing for both existing and new customers
                loadCustomerContentVariables(data.customerDisplayName);
            }
        }

        function hideEditingSection() {
            const defaultSection = document.getElementById('defaultSection');
            const editingSection = document.getElementById('editingSection');

            if (editingSection) editingSection.style.display = 'none';
            if (defaultSection) defaultSection.style.display = 'block';
        }

        // Content Variables functionality
        let customerContentVariables = {};
        let globalContentVariables = {};
        let currentCustomerDisplayName = '';

        function loadCustomerContentVariables(customerDisplayName) {
            currentCustomerDisplayName = customerDisplayName;
            
            fetch(`/CustomerSettings?handler=CustomerContentVariables&customerDisplayName=${encodeURIComponent(customerDisplayName)}`)
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        customerContentVariables = data.customerVariables || {};
                        globalContentVariables = data.globalVariables || {};
                        renderContentVariablesEditor();
                    } else {
                        throw new Error(data.error || 'Failed to load content variables');
                    }
                })
                .catch(error => {
                    console.error('Error loading content variables:', error);
                    showEmptyVariablesEditor();
                });
        }

        function renderContentVariablesEditor() {
            const container = document.getElementById('contentVariablesContainer');
            
            if (Object.keys(customerContentVariables).length === 0 && Object.keys(globalContentVariables).length === 0) {
                showEmptyVariablesEditor();
                return;
            }
            
            let tableHtml = `
                <div class="table-responsive">
                    <table class="table table-striped table-hover" id="contentVariablesTable">
                        <thead class="table-dark">
                            <tr>
                                <th style="width: 25%">Variable Name</th>
                                <th style="width: 50%">Value</th>
                                <th style="width: 15%">Is Redefined</th>
                                <th style="width: 10%">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
            `;
            
            // Add customer-specific variables first (unique ones not in notifications.json)
            Object.entries(customerContentVariables).forEach(([key, value]) => {
                if (!globalContentVariables.hasOwnProperty(key)) {
                    tableHtml += `
                        <tr data-variable-type="customer" data-original-key="${key}">
                            <td>
                                <input type="text" class="form-control form-control-sm variable-name" value="${escapeHtml(key)}" />
                            </td>
                            <td>
                                <input type="text" class="form-control form-control-sm variable-value" value="${escapeHtml(value)}" />
                            </td>
                            <td class="text-center">
                                <span class="text-muted">-</span>
                            </td>
                            <td class="text-center">
                                <button type="button" class="btn btn-danger btn-sm delete-variable" onclick="deleteVariable(this)">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    `;
                }
            });
            
            // Add global variables (with checkbox, name read-only when checked)
            Object.entries(globalContentVariables).forEach(([key, value]) => {
                const isRedefined = customerContentVariables.hasOwnProperty(key);
                const actualValue = isRedefined ? customerContentVariables[key] : value;
                
                tableHtml += `
                    <tr data-variable-type="global" data-original-key="${key}">
                        <td>
                            <input type="text" class="form-control form-control-sm variable-name" value="${escapeHtml(key)}" readonly />
                        </td>
                        <td>
                            <input type="text" class="form-control form-control-sm variable-value" value="${escapeHtml(actualValue)}" ${!isRedefined ? 'readonly' : ''} />
                        </td>
                        <td class="text-center">
                            <div class="form-check">
                                <input class="form-check-input redefined-checkbox" type="checkbox" ${isRedefined ? 'checked' : ''} onchange="toggleVariableRedefinition(this)" />
                            </div>
                        </td>
                        <td class="text-center">
                            <span class="text-muted">-</span>
                        </td>
                    </tr>
                `;
            });
            
            tableHtml += `
                        </tbody>
                    </table>
                </div>
            `;
            
            container.innerHTML = tableHtml;
        }

        function showEmptyVariablesEditor() {
            const container = document.getElementById('contentVariablesContainer');
            container.innerHTML = `
                <div class="text-center py-4">
                    <i class="fas fa-code fa-3x text-muted mb-3"></i>
                    <h5 class="text-muted">No Content Variables</h5>
                    <p class="text-muted">No content variables found for this customer. Click "Add Variable" to start adding variables.</p>
                </div>
            `;
        }

        function addNewVariable() {
            const table = document.getElementById('contentVariablesTable');
            let tbody;
            
            if (!table) {
                // Create new table if it doesn't exist
                const container = document.getElementById('contentVariablesContainer');
                container.innerHTML = `
                    <div class="table-responsive">
                        <table class="table table-striped table-hover" id="contentVariablesTable">
                            <thead class="table-dark">
                                <tr>
                                    <th style="width: 25%">Variable Name</th>
                                    <th style="width: 50%">Value</th>
                                    <th style="width: 15%">Is Redefined</th>
                                    <th style="width: 10%">Actions</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                `;
                tbody = document.querySelector('#contentVariablesTable tbody');
            } else {
                tbody = table.getElementsByTagName('tbody')[0];
            }
            
            // Insert new row at the top
            const newRow = tbody.insertRow(0);
            newRow.setAttribute('data-variable-type', 'customer');
            newRow.setAttribute('data-original-key', '');
            
            newRow.innerHTML = `
                <td>
                    <input type="text" class="form-control form-control-sm variable-name" value="" placeholder="Enter variable name" />
                </td>
                <td>
                    <input type="text" class="form-control form-control-sm variable-value" value="" placeholder="Enter variable value" />
                </td>
                <td class="text-center">
                    <span class="text-muted">-</span>
                </td>
                <td class="text-center">
                    <button type="button" class="btn btn-danger btn-sm delete-variable" onclick="deleteVariable(this)">
                        <i class="fas fa-trash"></i>
                    </button>
                </td>
            `;
            
            // Focus on the variable name input
            const nameInput = newRow.querySelector('.variable-name');
            if (nameInput) {
                nameInput.focus();
            }
        }

        function deleteVariable(button) {
            const row = button.closest('tr');
            if (row) {
                row.remove();
            }
        }

        function toggleVariableRedefinition(checkbox) {
            const row = checkbox.closest('tr');
            const valueInput = row.querySelector('.variable-value');
            
            if (checkbox.checked) {
                // Enable editing for redefined global variable
                valueInput.removeAttribute('readonly');
                valueInput.classList.remove('form-control-plaintext');
                valueInput.classList.add('form-control');
            } else {
                // Disable editing and reset to global value
                const originalKey = row.getAttribute('data-original-key');
                const globalValue = globalContentVariables[originalKey] || '';
                valueInput.value = globalValue;
                valueInput.setAttribute('readonly', true);
                valueInput.classList.remove('form-control');
                valueInput.classList.add('form-control-plaintext');
            }
        }

        function saveContentVariables() {
            const table = document.getElementById('contentVariablesTable');
            if (!table) {
                // No variables to save
                fetch('/CustomerSettings?handler=SaveCustomerContentVariables', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                    },
                    body: `customerDisplayName=${encodeURIComponent(currentCustomerDisplayName)}&contentVariables=${encodeURIComponent(JSON.stringify({}))}`
                })
                .then(response => response.json())
                .then(result => {
                    if (result.success) {
                        showMessage(result.message, 'success');
                    } else {
                        showMessage(result.error || 'Failed to save content variables.', 'error');
                    }
                })
                .catch(error => {
                    console.error('Error saving content variables:', error);
                    showMessage('An error occurred while saving content variables.', 'error');
                });
                return;
            }
            
            const rows = table.querySelectorAll('tbody tr');
            const variables = {};
            let hasError = false;
            
            rows.forEach(row => {
                const variableType = row.getAttribute('data-variable-type');
                const nameInput = row.querySelector('.variable-name');
                const valueInput = row.querySelector('.variable-value');
                const redefinedCheckbox = row.querySelector('.redefined-checkbox');
                
                const name = nameInput.value.trim();
                const value = valueInput.value.trim();
                
                // Validate variable name for customer variables
                if (variableType === 'customer' && name === '') {
                    nameInput.classList.add('is-invalid');
                    hasError = true;
                    return;
                } else {
                    nameInput.classList.remove('is-invalid');
                }
                
                // Save customer variables and redefined global variables
                if (variableType === 'customer') {
                    // For customer variables, only save if name is not empty (value can be empty)
                    if (name) {
                        variables[name] = value; // This will save empty strings as ""
                    }
                } else if (variableType === 'global' && redefinedCheckbox && redefinedCheckbox.checked) {
                    // For redefined global variables, always save (name is always present, value can be empty)
                    variables[name] = value; // This will save empty strings as ""
                }
            });
            
            if (hasError) {
                showMessage('Please fill in all required fields.', 'error');
                return;
            }
            
            // Save to backend
            fetch('/CustomerSettings?handler=SaveCustomerContentVariables', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                },
                body: `customerDisplayName=${encodeURIComponent(currentCustomerDisplayName)}&contentVariables=${encodeURIComponent(JSON.stringify(variables))}`
            })
            .then(response => response.json())
            .then(result => {
                if (result.success) {
                    showMessage(result.message, 'success');
                    // Reload the variables to reflect the saved state
                    loadCustomerContentVariables(currentCustomerDisplayName);
                } else {
                    showMessage(result.error || 'Failed to save content variables.', 'error');
                }
            })
            .catch(error => {
                console.error('Error saving content variables:', error);
                showMessage('An error occurred while saving content variables.', 'error');
            });
        }

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        function showMessage(message, type) {
            // Remove existing alerts
            const existingAlerts = document.querySelectorAll('.alert');
            existingAlerts.forEach(alert => {
                if (alert.classList.contains('alert-success') || alert.classList.contains('alert-danger')) {
                    alert.remove();
                }
            });
            
            // Create new alert
            const alertClass = type === 'success' ? 'alert-success' : 'alert-danger';
            const icon = type === 'success' ? 'fa-check-circle' : 'fa-exclamation-triangle';
            
            const alertHtml = `
                <div class="alert ${alertClass} alert-dismissible fade show" role="alert">
                    <i class="fas ${icon} me-2"></i>${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            `;
            
            // Insert after the h1 element
            const h1 = document.querySelector('h1');
            if (h1) {
                h1.insertAdjacentHTML('afterend', alertHtml);
            }
        }

        function validateForm(form) {
            // Skip validation for ConfirmOverwrite forms (they only contain hidden fields)
            if (form && form.getAttribute('asp-page-handler') === 'ConfirmOverwrite') {
                return true;
            }
            
            const customerNameInput = document.getElementById('customerNameInput');
            
            if (customerNameInput) {
                if (!selectedCustomerValid && customerNameInput.value.trim() !== '') {
                    alert('Please select a valid customer from the suggestions.');
                    return false;
                }
                
                // If a customer is selected, extract the customer ID for form submission
                if (selectedCustomerValid && customerNameInput.hasAttribute('data-customer-id')) {
                    // Create a hidden input with the customer ID for backend processing
                    let hiddenCustomerIdInput = document.getElementById('hiddenCustomerId');
                    if (!hiddenCustomerIdInput) {
                        hiddenCustomerIdInput = document.createElement('input');
                        hiddenCustomerIdInput.type = 'hidden';
                        hiddenCustomerIdInput.name = 'Upload.CustomerIdForFilename';
                        hiddenCustomerIdInput.id = 'hiddenCustomerId';
                        customerNameInput.parentNode.appendChild(hiddenCustomerIdInput);
                    }
                    hiddenCustomerIdInput.value = customerNameInput.getAttribute('data-customer-id');
                }
            }
            return true;
        }
        
        // Initialize on page load
        document.addEventListener('DOMContentLoaded', function() {
            // Set up form validation for upload forms only
            const forms = document.querySelectorAll('form');
            forms.forEach(form => {
                form.addEventListener('submit', function(e) {
                    if (!validateForm(this)) {
                        e.preventDefault();
                    }
                });
            });

            // Initialize customer search
            setupCustomerSearch();
            
            // Initialize content variables functionality
            document.addEventListener('click', function(e) {
                if (e.target.id === 'addVariableBtn' || e.target.closest('#addVariableBtn')) {
                    addNewVariable();
                }
                
                if (e.target.id === 'saveVariablesBtn' || e.target.closest('#saveVariablesBtn')) {
                    saveContentVariables();
                }
            });
        });
    </script>
}
