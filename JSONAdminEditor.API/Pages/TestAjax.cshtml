@page
@model TestAjaxModel

<h1>Test AJAX</h1>
<button onclick="testAjax()">Test</button>
<div id="result"></div>

<script>
function testAjax() {
    console.log('Testing AJAX call...');
    const xhr = new XMLHttpRequest();
    xhr.open('GET', '/TestAjax?handler=TestEndpoint&term=test', true);
    xhr.onreadystatechange = function() {
        console.log('State:', xhr.readyState, 'Status:', xhr.status);
        if (xhr.readyState === 4) {
            document.getElementById('result').innerHTML = xhr.responseText;
        }
    };
    xhr.send();
}
</script>
