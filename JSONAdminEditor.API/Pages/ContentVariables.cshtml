@page
@model JSONAdminEditor.Pages.ContentVariablesModel
@using JSONAdminEditor.Models
@using System
@{
    ViewData["Title"] = "Content Variables";
}

<div class="container-fluid">
    <h1 class="mb-4">Content Variables Management</h1>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@Model.SuccessMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card">
        <div class="card-header">
            <h3><i class="fas fa-tags me-2"></i>Content Variables Settings</h3>
            <p class="mb-0 text-muted">Manage content variable mappings used in notifications. Variable names must be unique and will be used as placeholder identifiers.</p>
        </div>
        <div class="card-body">
            @if (Model.Data?.Any() == true)
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover" id="dataTable">
                        <thead class="table-dark">
                            <tr>
                                <th>Variable Name</th>
                                <th>Variable Mapping</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Data.Count; i++)
                            {
                                var row = Model.Data[i];
                                <tr data-row-index="@i">
                                    @foreach (var kvp in row)
                                    {
                                        var fieldName = kvp.Key;
                                        var value = kvp.Value;
                                        var cellId = $"cell-{i}-{fieldName}";
                                        var hasError = Model.ValidationResult?.Errors?.Any(e => e.RowIndex == i && e.FieldName == fieldName) == true;
                                        var errorMessage = Model.ValidationResult?.Errors?.FirstOrDefault(e => e.RowIndex == i && e.FieldName == fieldName)?.Message;

                                        <td class="editable-cell @(hasError ? "validation-error" : "")" 
                                            data-field="@fieldName" 
                                            data-row="@i" 
                                            id="@cellId">
                                            <input type="text" class="form-control" value="@value" data-original-value="@value" />
                                            @if (hasError)
                                            {
                                                <div class="validation-error-message">@errorMessage</div>
                                            }
                                        </td>
                                    }
                                    <td>
                                        <button type="button" class="btn btn-danger btn-sm delete-row">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="mt-3">
                    <button type="button" class="btn btn-success me-2" id="addRowBtn">
                        <i class="fas fa-plus me-1"></i>Add Variable
                    </button>
                    <form method="post" asp-page-handler="Save" class="d-inline">
                        <input type="hidden" name="jsonData" id="jsonData" />
                        <button type="submit" class="btn btn-primary" id="saveBtn">
                            <i class="fas fa-save me-1"></i>Save Changes
                        </button>
                    </form>
                </div>
            }
            else
            {
                <div class="text-center py-4">
                    <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                    <p class="text-muted">No content variables found.</p>
                    <button type="button" class="btn btn-primary" id="addFirstRowBtn">
                        <i class="fas fa-plus me-1"></i>Add First Variable
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let validationErrors = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ValidationResult?.Errors ?? new List<ValidationError>()));

        document.addEventListener('DOMContentLoaded', function() {
            initializeTable();
        });

        function initializeTable() {
            // Handle add row button
            const addRowBtn = document.getElementById('addRowBtn');
            const addFirstRowBtn = document.getElementById('addFirstRowBtn');
            
            if (addRowBtn) {
                addRowBtn.addEventListener('click', addRow);
            }
            
            if (addFirstRowBtn) {
                addFirstRowBtn.addEventListener('click', function() {
                    // Create initial table structure
                    const container = document.querySelector('.card-body');
                    const tableHtml = `
                        <div class="table-responsive">
                            <table class="table table-striped table-hover" id="dataTable">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Variable Name</th>
                                        <th>Variable Mapping</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                        <div class="mt-3">
                            <button type="button" class="btn btn-success me-2" id="addRowBtn">
                                <i class="fas fa-plus me-1"></i>Add Variable
                            </button>
                            <form method="post" asp-page-handler="Save" class="d-inline">
                                <input type="hidden" name="jsonData" id="jsonData" />
                                <button type="submit" class="btn btn-primary" id="saveBtn">
                                    <i class="fas fa-save me-1"></i>Save Changes
                                </button>
                            </form>
                        </div>
                    `;
                    
                    container.innerHTML = tableHtml;
                    document.getElementById('addRowBtn').addEventListener('click', addRow);
                    addRow();
                });
            }

            // Handle delete row buttons
            document.addEventListener('click', function(e) {
                if (e.target.classList.contains('delete-row') || e.target.parentElement.classList.contains('delete-row')) {
                    const row = e.target.closest('tr');
                    if (row) {
                        row.remove();
                        updateRowIndices();
                    }
                }
            });

            // Handle save button
            const saveBtn = document.getElementById('saveBtn');
            if (saveBtn) {
                saveBtn.addEventListener('click', function(e) {
                    if (!validateAndPrepareData()) {
                        e.preventDefault();
                        return false;
                    }
                });
            }

            // Handle input changes to clear validation errors
            document.addEventListener('change', function(e) {
                if (e.target.matches('.editable-cell input')) {
                    clearValidationError(e.target);
                }
            });

            document.addEventListener('input', function(e) {
                if (e.target.matches('.editable-cell input')) {
                    clearValidationError(e.target);
                }
            });
        }

        function addRow() {
            const tbody = document.querySelector('#dataTable tbody');
            if (!tbody) return;

            const rowIndex = tbody.children.length;

            const newRow = document.createElement('tr');
            newRow.setAttribute('data-row-index', rowIndex);
            newRow.innerHTML = `
                <td class="editable-cell" data-field="Variable Name" data-row="${rowIndex}">
                    <input type="text" class="form-control" value="" data-original-value="" placeholder="Enter variable name..." />
                </td>
                <td class="editable-cell" data-field="Variable Mapping" data-row="${rowIndex}">
                    <input type="text" class="form-control" value="" data-original-value="" placeholder="Enter mapping value..." />
                </td>
                <td>
                    <button type="button" class="btn btn-danger btn-sm delete-row">
                        <i class="fas fa-trash"></i>
                    </button>
                </td>
            `;

            tbody.appendChild(newRow);
        }

        function updateRowIndices() {
            const rows = document.querySelectorAll('#dataTable tbody tr');
            rows.forEach((row, index) => {
                row.setAttribute('data-row-index', index);
                row.querySelectorAll('.editable-cell').forEach(cell => {
                    cell.setAttribute('data-row', index);
                });
            });
        }

        function validateAndPrepareData() {
            const data = [];
            const rows = document.querySelectorAll('#dataTable tbody tr');
            let hasErrors = false;

            // Clear previous validation errors
            document.querySelectorAll('.validation-error').forEach(el => {
                el.classList.remove('validation-error');
            });
            document.querySelectorAll('.validation-error-message').forEach(el => {
                el.remove();
            });

            rows.forEach((row, rowIndex) => {
                const rowData = {};
                const cells = row.querySelectorAll('.editable-cell');
                
                cells.forEach(cell => {
                    const field = cell.getAttribute('data-field');
                    const input = cell.querySelector('input');
                    
                    if (input) {
                        rowData[field] = input.value.trim();
                    }
                });
                
                data.push(rowData);
            });

            // Validate variable name uniqueness
            const seenVariableNames = new Set();
            const duplicates = new Set();
            
            data.forEach((row, index) => {
                const variableName = row['Variable Name'];
                if (variableName) {
                    const lowerName = variableName.toLowerCase();
                    if (seenVariableNames.has(lowerName)) {
                        duplicates.add(lowerName);
                    } else {
                        seenVariableNames.add(lowerName);
                    }
                }
            });

            // Show validation errors
            data.forEach((row, index) => {
                const variableName = row['Variable Name'];
                
                if (!variableName || variableName === '') {
                    showValidationError(index, 'Variable Name', 'Variable Name is required');
                    hasErrors = true;
                } else if (duplicates.has(variableName.toLowerCase())) {
                    showValidationError(index, 'Variable Name', `Duplicate Variable Name: '${variableName}' must be unique`);
                    hasErrors = true;
                }
            });

            if (hasErrors) {
                return false;
            }

            // Set the JSON data for submission
            document.getElementById('jsonData').value = JSON.stringify(data);
            return true;
        }

        function showValidationError(rowIndex, fieldName, message) {
            const cell = document.querySelector(`[data-row="${rowIndex}"][data-field="${fieldName}"]`);
            if (cell) {
                cell.classList.add('validation-error');
                
                // Remove existing error message
                const existingError = cell.querySelector('.validation-error-message');
                if (existingError) {
                    existingError.remove();
                }
                
                // Add new error message
                const errorDiv = document.createElement('div');
                errorDiv.className = 'validation-error-message';
                errorDiv.textContent = message;
                cell.appendChild(errorDiv);
            }
        }

        function clearValidationError(input) {
            const cell = input.closest('.editable-cell');
            if (cell) {
                cell.classList.remove('validation-error');
                const errorMsg = cell.querySelector('.validation-error-message');
                if (errorMsg) {
                    errorMsg.remove();
                }
            }
        }
    </script>

    <style>
        .validation-error {
            border: 2px solid #dc3545 !important;
            background-color: #f8d7da !important;
        }

        .validation-error-message {
            color: #dc3545;
            font-size: 0.875em;
            margin-top: 0.25rem;
            font-weight: 500;
        }

        .editable-cell input {
            border: 1px solid #ced4da;
            transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
        }

        .editable-cell input:focus {
            border-color: #80bdff;
            box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
        }

        .table th {
            background-color: #343a40;
            color: white;
            font-weight: 600;
        }

        .btn-danger.btn-sm {
            padding: 0.25rem 0.5rem;
            font-size: 0.875rem;
        }

        .editable-cell input::placeholder {
            color: #6c757d;
            opacity: 1;
        }
    </style>
}
